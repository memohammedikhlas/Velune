<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black">

    <TextView
        android:id="@+id/timeText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="09:20 PM"
        android:textColor="@color/white"
        android:textSize="@dimen/text_display"
        android:fontFamily="sans-serif-light"
        android:layout_marginStart="@dimen/space_lg"
        android:layout_marginTop="88dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>

    <TextView
        android:id="@+id/dateText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Sunday, May 3"
        android:textColor="@color/text_secondary"
        android:textSize="@dimen/text_subtitle"
        android:letterSpacing="0.02"
        android:layout_marginStart="@dimen/space_lg"
        android:layout_marginTop="@dimen/space_sm"
        app:layout_constraintTop_toBottomOf="@id/timeText"
        app:layout_constraintStart_toStartOf="parent"/>

    <TextView
        android:id="@+id/favoritesTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="FAVORITES"
        android:textColor="@color/text_tertiary"
        android:textSize="@dimen/text_caption"
        android:fontFamily="sans-serif-medium"
        android:letterSpacing="0.12"
        android:layout_marginStart="@dimen/space_lg"
        android:layout_marginTop="@dimen/space_xl"
        app:layout_constraintTop_toBottomOf="@id/dateText"
        app:layout_constraintStart_toStartOf="parent"/>

    <ListView
        android:id="@+id/favoritesList"
        android:layout_width="0dp"
        android:layout_height="180dp"

        android:divider="@android:color/transparent"
        android:dividerHeight="@dimen/space_sm"

        android:layout_marginStart="@dimen/space_lg"
        android:layout_marginEnd="@dimen/space_lg"
        android:layout_marginTop="@dimen/space_sm"

        app:layout_constraintTop_toBottomOf="@id/favoritesTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <TextView
        android:id="@+id/logoText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="VELUNE"
        android:textColor="@color/text_tertiary"
        android:textSize="@dimen/text_caption"
        android:fontFamily="sans-serif-medium"
        android:letterSpacing="0.2"

        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"

        android:layout_marginBottom="@dimen/space_xl"/>

</androidx.constraintlayout.widget.ConstraintLayout>