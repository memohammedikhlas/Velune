<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:id="@+id/statsTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Focus Statistics"
        android:textSize="28sp"
        android:textStyle="bold"/>

    <TextView
        android:id="@+id/statsMinutes"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Focus Time: 0 min"
        android:textSize="20sp"
        android:layout_marginTop="32dp"/>

    <TextView
        android:id="@+id/statsSessions"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Sessions: 0"
        android:textSize="20sp"
        android:layout_marginTop="16dp"/>

    <TextView
        android:id="@+id/mostUsedTimer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Most Used Timer: -"
        android:textSize="20sp"
        android:layout_marginTop="16dp"/>

    <TextView
        android:id="@+id/streakText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Current Streak: 0 Days"
        android:textSize="20sp"
        android:layout_marginTop="16dp"/>

</LinearLayout>