<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme — forced dark (OLED black), monochrome accent,
         so every stock widget (Button, Switch, SeekBar, AlertDialog) picks up
         Velune's own palette instead of default Material purple/teal. -->
    <style name="Base.Theme.VeluneLauncher" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/white</item>
        <item name="colorOnPrimary">@color/black</item>
        <item name="colorSecondary">@color/white</item>
        <item name="colorOnSecondary">@color/black</item>
        <item name="colorSurface">@color/card_bg</item>
        <item name="colorOnSurface">@color/white</item>
        <item name="colorSurfaceVariant">@color/card_bg</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>
        <item name="colorOutline">@color/card_border</item>
        <item name="android:colorBackground">@color/black</item>
        <item name="android:textColorPrimary">@color/white</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <style name="Theme.VeluneLauncher" parent="Base.Theme.VeluneLauncher" />

    <!-- Primary pill CTA: white background, black bold text, fully rounded -->
    <style name="Widget.Velune.Button.Pill" parent="Widget.Material3.Button">
        <item name="cornerRadius">@dimen/radius_pill</item>
        <item name="backgroundTint">@color/white</item>
        <item name="android:textColor">@color/black</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.03</item>
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingBottom">14dp</item>
        <item name="android:textSize">15sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <!-- Secondary/small pill: outlined, for compact inline actions -->
    <style name="Widget.Velune.Button.PillSmall" parent="Widget.Material3.Button.OutlinedButton">
        <item name="cornerRadius">@dimen/radius_pill</item>
        <item name="strokeColor">@color/card_border</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">13sp</item>
    </style>
</resources>